{
  "name": "devflow-toolkit",
  "displayName": "DevFlow — AI Runbooks from Tickets",
  "description": "Turn Jira, Azure DevOps and GitHub tickets into codebase-aware, AI-generated implementation runbooks — right inside VS Code.",
  "version": "1.0.0",
  "publisher": "ganeshvenkatesanofficial",
  "author": {
    "name": "Ganesh Venkatesan",
    "email": "ganeshvenkatesanofficial@gmail.com"
  },
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/ganesh-venkatesan/devflow"
  },
  "bugs": {
    "url": "https://github.com/ganesh-venkatesan/devflow/issues"
  },
  "homepage": "https://github.com/ganesh-venkatesan/devflow#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "jira",
    "azure devops",
    "github",
    "ai",
    "runbook",
    "ticket",
    "planning",
    "codebase",
    "productivity",
    "developer tools"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "devflow.open",
        "title": "DevFlow: Open Panel"
      },
      {
        "command": "devflow.clearStorage",
        "title": "DevFlow: Clear All Data"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "devflow-sidebar",
          "title": "DevFlow",
          "icon": "icon.png"
        }
      ]
    },
    "views": {
      "devflow-sidebar": [
        {
          "type": "webview",
          "id": "devflow.mainView",
          "name": "DevFlow"
        }
      ]
    },
    "configuration": {
      "title": "DevFlow",
      "properties": {
        "devflow.pythonPath": {
          "type": "string",
          "default": "python3",
          "description": "Path to the Python interpreter used to run the DevFlow backend."
        },
        "devflow.backendPort": {
          "type": "number",
          "default": 9120,
          "description": "Local port for the DevFlow backend server."
        },
        "devflow.backendHost": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "Host the DevFlow backend binds to."
        },
        "devflow.startupTimeoutMs": {
          "type": "number",
          "default": 10000,
          "description": "Max milliseconds to wait for the backend to become ready."
        },
        "devflow.logLevel": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warning",
            "error"
          ],
          "default": "warning",
          "description": "Uvicorn log level for the backend process."
        }
      }
    }
  },
  "scripts": {
    "build:webview": "cd webview && npm run build",
    "compile": "npm run build:webview && webpack --mode production",
    "watch": "webpack --watch",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@vscode/vsce": "^2.24.0",
    "terser-webpack-plugin": "^5.6.1",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  }
}
